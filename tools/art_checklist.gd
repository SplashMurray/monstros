extends SceneTree
## Writes docs/ART_CHECKLIST.md: every piece of art the game data currently needs,
## and whether it has been delivered. Re-run after adding monsters, NPCs or art:
##   godot --headless -s tools/art_checklist.gd

const OUTPUT := "res://docs/ART_CHECKLIST.md"
const SECTIONS := [
	["Monsters", ["monster_front", "monster_back", "monster_icon"]],
	["Overworld characters", ["character"]],
	["Overworld objects", ["object"]],
	["Trainer portraits", ["trainer"]],
	["Tiles", ["tileset", "tileset_legend"]],
	["Battle backgrounds", ["battle_bg", "battle_base"]],
	["Interface", ["type_badge", "status_badge", "frame", "title_logo", "font"]],
	["App icon", ["app_icon", "adaptive_icon"]],
]


func _initialize() -> void:
	Dex.ensure_loaded()
	var assets := Art.required_assets()
	var done := 0
	for entry in assets:
		if FileAccess.file_exists(Art.ROOT + entry["path"]):
			done += 1
	var lines := [
		"# Art checklist",
		"",
		"Generated by `tools/art_checklist.gd` from the game data. Don't edit it by hand. The format",
		"for each file is in [ART_SPEC.md](ART_SPEC.md). Paths are relative to `assets/`.",
		"",
		"**%d of %d delivered.** \"In game\" = the engine already displays it; \"Planned\" = specified, not shown yet." % [done, assets.size()],
	]
	for section in SECTIONS:
		lines.append_array(["", "## " + section[0], "", "| Done | File | Size | For | Status |", "|---|---|---|---|---|"])
		for entry in assets:
			if entry["kind"] in section[1]:
				var size: Vector2i = entry["size"]
				var size_text := "%dx%d" % [size.x, size.y] if size != Vector2i.ZERO else _size_note(entry["kind"])
				var delivered := FileAccess.file_exists(Art.ROOT + entry["path"])
				lines.append("| %s | `%s` | %s | %s | %s |" % [
					"✅" if delivered else "⬜", entry["path"], size_text, entry["for"], "In game" if entry["used"] else "Planned"])
	var file := FileAccess.open(OUTPUT, FileAccess.WRITE)
	file.store_string("\n".join(lines) + "\n")
	file.close()
	print("Wrote %s (%d/%d delivered)" % [OUTPUT, done, assets.size()])
	quit()


func _size_note(kind: String) -> String:
	match kind:
		"character":
			return "48x128"
		"tileset":
			return "128 x (16n)"
		"tileset_legend":
			return "JSON"
		"title_logo":
			return "≤ 240x80"
		"font":
			return "TTF/OTF"
	return "-"
